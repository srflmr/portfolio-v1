---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const BADGE_IDS = [
  '3ce3bbbd-66d0-4ece-801d-7d279617d14d',
  'fe1cbbb6-c452-4885-9874-6b9a6db79056',
  'eac07a29-6681-4715-bbe2-e55076b03996',
  'acae8294-ff72-40ed-8b3a-a6c527ff3629',
  'fb28d501-fd25-46a3-9eed-924356d95b16',
  'b9dab04e-0d44-44cf-b1e8-9196485d7ea9',
  '57599b06-8ca4-44ab-9292-50b17bb69870',
  '88d5dadd-a1fd-4613-bb03-5bec0e2c55d1',
  'fda050a8-8f42-4799-949a-6988fac2e1cc',
  'b2bb036a-4497-471b-ace2-96e4ad7d85e6',
];

const SKILLS = [
  {
    category: 'Detection & Response',
    tags: ['Threat Detection', 'Threat Hunting', 'SOC Operations', 'Incident Response', 'SIEM Engineering'],
  },
  {
    category: 'Security Operations',
    tags: ['SIEM', 'Log Analysis', 'Security Monitoring', 'SOC Assessment'],
  },
  {
    category: 'Threat Intelligence',
    tags: ['MITRE ATT&CK', 'TTP Mapping', 'IOC Analysis', 'Cyber Threat Intelligence'],
  },
  {
    category: 'Technical Tools',
    tags: ['Python', 'Linux', 'Bash', 'Git'],
  },
  {
    category: 'Cloud Security',
    tags: ['Google Cloud (ACE)', 'Cloud Architecture', 'IAM', 'Cloud Monitoring'],
  },
  {
    category: 'DevOps & Infrastructure',
    tags: ['DevOps Fundamentals', 'Shell Scripting', 'CI/CD', 'Docker'],
  },
];
---

<BaseLayout
  title="About | Isrofil Amar"
  description="About Isrofil Amar - Career journey, skills, and certifications"
>
  <Header currentPage="about" />

  <main id="content">
    <!-- Hero Section -->
    <section class="pt-24 pb-12 md:pt-32 md:pb-16 lg:pt-32 lg:pb-20">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight mb-4 anim-fade-up anim-delay-1">
          About Me
        </h1>
        <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed text-pretty italic anim-fade-up anim-delay-2">
          Every adversary leaves a shadow.<br />
          My journey — from watching those shadows <br class="lg:hidden" />to holding the light<br />
          that makes the unseen visible.
        </p>
      </div>
    </section>

    <!-- Career Narrative Section -->
    <section class="py-16 md:py-24 bg-surface">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl md:text-3xl font-semibold text-text-primary mb-6">From Shadows to Clarity</h2>
            <div class="space-y-4 text-text-secondary leading-relaxed text-pretty overflow-hidden">
              <p class="text-sm md:text-base">
                I started as an Associate Security Analyst, drawn to the quiet work of making sense of noise. Day by day, I learned how adversaries leave shadows — fragments in alerts and logs that only become meaningful when you connect them with context and evidence. That experience shaped how I think: patient, curious, and grounded in what the data can prove.
              </p>
              <p class="text-sm md:text-base">
                Today, I work as an Associate Cyber Threat Detection Engineer. I build and maintain SIEM detections that bring hidden behavior into the light, then keep them healthy over time — tuning thresholds, refining logic, and automating what should be repeatable. I care about detections that are not only clever, but reliable: the kind you can trust when it matters.
              </p>
            </div>
          </div>
          <div class="bg-bg p-6 md:p-8 rounded-xl border border-border max-w-lg lg:max-w-none mx-auto w-full">
            <h3 class="text-lg font-semibold text-text-primary mb-4">Overview</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div>
                  <p class="font-medium text-text-primary">Current Role</p>
                  <p class="text-base text-text-secondary">Associate Cyber Threat Detection Engineer</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <div>
                  <p class="font-medium text-text-primary">Company</p>
                  <p class="text-base text-text-secondary">PT Korelasi Persada Indonesia</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
                <div>
                  <p class="font-medium text-text-primary">Education</p>
                  <p class="text-base text-text-secondary">Informatika — Universitas Ciputra</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-text-primary mb-4">Skills & Expertise</h2>
          <p class="text-text-secondary max-w-xl mx-auto leading-relaxed text-pretty">
            Skills built through hands-on security work and continuous learning.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {SKILLS.map(({ category, tags }) => (
            <div class="bg-surface p-6 md:p-8 rounded-xl border border-border">
              <h3 class="text-lg font-semibold text-text-primary mb-4">{category}</h3>
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li>
                    <span class="px-3 py-1 bg-accent-light text-accent-hover text-sm font-medium rounded-full">{tag}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section id="certifications" class="py-16 md:py-24 bg-surface">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-text-primary mb-4">Certifications</h2>
          <p class="text-text-secondary max-w-xl mx-auto leading-relaxed text-pretty">
            Industry-recognized certifications validating expertise across security domains.
          </p>
        </div>

        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3 sm:gap-4">
          {BADGE_IDS.map((id, i) => (
            <div class="aspect-square bg-bg rounded-xl border border-border flex items-center justify-center p-2 sm:p-3">
              <img
                src={`/images/badges/badge-${i + 1}.png`}
                alt={`Certification badge ${i + 1}`}
                class="w-full h-full object-contain"
                width="200"
                height="200"
                loading={i < 6 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          ))}
        </div>

        <div class="text-center mt-10 space-y-4">
          <p class="text-text-secondary text-sm">
            More certifications available on my LinkedIn and Credly profiles.
          </p>
          <div class="flex items-center justify-center gap-6">
            <a
              href="https://linkedin.com/in/isrofilamar"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-accent hover:text-accent-hover font-semibold transition-colors focus-ring rounded-sm"
            >
              View on LinkedIn
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://credly.com/users/isrofilamar"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-accent hover:text-accent-hover font-semibold transition-colors focus-ring rounded-sm"
            >
              View on Credly
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-2xl md:text-3xl font-semibold text-text-primary mb-4">Education</h2>
        </div>

        <div class="max-w-2xl mx-auto">
          <div class="bg-surface p-6 md:p-8 rounded-xl border border-border">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-accent-light rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary">Universitas Ciputra</h3>
                <p class="text-accent font-medium">Informatika</p>
                <p class="text-sm text-text-secondary mt-1">Undergraduate Program · 2025 — Present</p>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-12">
          <p class="text-text-secondary leading-relaxed text-pretty mb-6">
            Interested in working together or want to know more?
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 bg-accent hover:bg-accent-hover text-white font-semibold rounded-lg transition-colors focus-ring">
            Get in Touch
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
