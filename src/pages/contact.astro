---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact | Isrofil Amar"
  description="Contact Isrofil Amar - Get in touch via email, LinkedIn, GitHub, or Credly"
>
  <Header currentPage="contact" />

  <main id="content">
    <!-- Hero Section -->
    <section class="pt-24 pb-12 md:pt-32 md:pb-16 lg:pt-32 lg:pb-20">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight mb-4 anim-fade-up anim-delay-1">
          Get in Touch
        </h1>
        <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed text-pretty anim-fade-up anim-delay-2">
          Open to security conversations, collaborations,<br />
          and new opportunities — let's connect.
        </p>
      </div>
    </section>

    <!-- Contact Links Section -->
    <section class="pt-6 pb-12 md:pt-10 md:pb-16 lg:pt-12 lg:pb-16 bg-surface">
      <div class="max-w-3xl mx-auto px-6">
        <div class="grid gap-6">
          <!-- Email -->
          <a
            href="mailto:isrofil.amar@gmail.com"
            class="group flex items-center gap-3 md:gap-6 p-4 md:p-6 lg:p-8 bg-bg rounded-xl border border-border hover:border-accent hover:shadow-md transition-colors transition-shadow duration-200 focus-ring"
          >
            <div class="w-11 h-11 md:w-14 md:h-14 bg-accent-light rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 md:w-7 md:h-7 text-accent group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-base md:text-lg font-semibold text-text-primary mb-0.5 md:mb-1">Email</h3>
              <p class="text-sm md:text-base text-text-secondary truncate">isrofil.amar@gmail.com</p>
            </div>
            <svg class="w-4 h-4 md:w-5 md:h-5 text-text-secondary group-hover:text-accent transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://linkedin.com/in/isrofilamar"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 md:gap-6 p-4 md:p-6 lg:p-8 bg-bg rounded-xl border border-border hover:border-accent hover:shadow-md transition-colors transition-shadow duration-200 focus-ring"
          >
            <div class="w-11 h-11 md:w-14 md:h-14 bg-accent-light rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 md:w-7 md:h-7 text-accent group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-base md:text-lg font-semibold text-text-primary mb-0.5 md:mb-1">LinkedIn</h3>
              <p class="text-sm md:text-base text-text-secondary truncate">linkedin.com/in/isrofilamar</p>
            </div>
            <svg class="w-4 h-4 md:w-5 md:h-5 text-text-secondary group-hover:text-accent transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/srflmr"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 md:gap-6 p-4 md:p-6 lg:p-8 bg-bg rounded-xl border border-border hover:border-accent hover:shadow-md transition-colors transition-shadow duration-200 focus-ring"
          >
            <div class="w-11 h-11 md:w-14 md:h-14 bg-accent-light rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 md:w-7 md:h-7 text-accent group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-base md:text-lg font-semibold text-text-primary mb-0.5 md:mb-1">GitHub</h3>
              <p class="text-sm md:text-base text-text-secondary truncate">github.com/srflmr</p>
            </div>
            <svg class="w-4 h-4 md:w-5 md:h-5 text-text-secondary group-hover:text-accent transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <!-- Credly -->
          <a
            href="https://credly.com/users/isrofilamar"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 md:gap-6 p-4 md:p-6 lg:p-8 bg-bg rounded-xl border border-border hover:border-accent hover:shadow-md transition-colors transition-shadow duration-200 focus-ring"
          >
            <div class="w-11 h-11 md:w-14 md:h-14 bg-accent-light rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 md:w-7 md:h-7 text-accent group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm0 3a7 7 0 100 14 7 7 0 000-14z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-base md:text-lg font-semibold text-text-primary mb-0.5 md:mb-1">Credly</h3>
              <p class="text-sm md:text-base text-text-secondary truncate">credly.com/users/isrofilamar</p>
            </div>
            <svg class="w-4 h-4 md:w-5 md:h-5 text-text-secondary group-hover:text-accent transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
