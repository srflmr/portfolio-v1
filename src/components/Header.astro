---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPage: 'home' | 'about' | 'contact';
}

const { currentPage } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home', page: 'home' },
  { href: '/about', label: 'About', page: 'about' },
  { href: '/contact', label: 'Contact', page: 'contact' },
];
---

<header class="fixed top-0 left-0 right-0 bg-bg/95 backdrop-blur-sm z-50 border-b border-border">
  <div class="max-w-6xl mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="text-xl font-semibold text-text-primary hover:text-accent transition-colors focus-ring rounded-sm" aria-label="Isrofil Amar — Home">
        IA
      </a>

      <!-- Desktop nav (md+) -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
        <ul class="flex items-center gap-8">
          {navLinks.map(({ href, label, page }) => (
            <li>
              <a
                href={href}
                class={currentPage === page
                  ? 'text-accent font-medium focus-ring rounded-sm'
                  : 'text-text-secondary hover:text-accent transition-colors focus-ring rounded-sm'}
                aria-current={currentPage === page ? 'page' : undefined}
              >{label}</a>
            </li>
          ))}
        </ul>
        <ThemeToggle />
      </nav>

      <!-- Mobile controls -->
      <div class="flex md:hidden items-center gap-1">
        <ThemeToggle />
        <button
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation menu"
          class="w-10 h-10 flex items-center justify-center rounded-lg text-text-secondary hover:text-accent hover:bg-accent-light transition-colors focus-ring"
        >
          <!-- Hamburger icon -->
          <svg class="menu-icon-open w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon -->
          <svg class="menu-icon-close w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-bg/95 backdrop-blur-sm" role="navigation" aria-label="Mobile navigation">
    <nav class="max-w-6xl mx-auto px-6 py-4">
      <ul class="flex flex-col gap-1">
        {navLinks.map(({ href, label, page }) => (
          <li>
            <a
              href={href}
              class={currentPage === page
                ? 'block px-4 py-3 rounded-lg text-accent font-medium bg-accent-light'
                : 'block px-4 py-3 rounded-lg text-text-secondary hover:text-accent hover:bg-accent-light transition-colors focus-ring'}
              aria-current={currentPage === page ? 'page' : undefined}
            >{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>document.getElementById('menu-btn').addEventListener('click',function(){var m=document.getElementById('mobile-menu');var isHidden=m.classList.toggle('hidden');this.setAttribute('aria-expanded',String(!isHidden))})</script>
